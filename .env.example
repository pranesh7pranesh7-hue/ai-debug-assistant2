# Environment Configuration for BugSense AI

# Application Settings
APP_NAME=BugSense AI
APP_ENV=development
DEBUG=True
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL default; fallback to SQLite for local standalone dev)
DATABASE_URL=postgresql://bugsense:bugsense_pass@localhost:5432/bugsense_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./bugsense.db

# LLM Provider Configuration
# Supported providers: anthropic, openai, gemini, ollama, mock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# API Keys (Set the key for your chosen provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Upload and Security Constraints
MAX_UPLOAD_SIZE_MB=2
SANDBOX_TIMEOUT_SECONDS=5
MAX_AGENTIC_RETRIES=3

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:8000"]
